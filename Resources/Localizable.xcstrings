{
  "sourceLanguage": "en",
  "strings": {
    "%@ (bit %@)": {
      "extractionState": "manual",
      "comment": "Hex code and the one bit that is set, e.g. 0x80 (bit 7)",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (бит %@)"
          }
        }
      }
    },
    "%@ (bits %@)": {
      "extractionState": "manual",
      "comment": "Hex code and the bits that are set, e.g. 0x81 (bits 0, 7)",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (биты %@)"
          }
        }
      }
    },
