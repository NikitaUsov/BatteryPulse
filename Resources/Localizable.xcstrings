    "A 15 W phone charger barely keeps up.": {
      "extractionState": "manual",
      "comment": "Demo scene subtitle",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарядное устройство от телефона на 15 Вт едва справляется."
          }
        }
      }
    },
    "A 60 W USB-C adapter charges the battery.": {
      "extractionState": "manual",
      "comment": "Demo scene subtitle",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаптер USB-C на 60 Вт заряжает аккумулятор."
