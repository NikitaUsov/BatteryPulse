    },
    "Adds raw IORegistry data, charger reason codes and capture export to the main window.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет в главное окно необработанные данные IORegistry, коды причин зарядки и экспорт снимка."
          }
        }
      }
    },
    "Advanced": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнения"
          }
        }
      }
    },
    "Allow BatteryPulse in Login Items to finish.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы завершить, разрешите BatteryPulse в разделе «Объекты входа»."
