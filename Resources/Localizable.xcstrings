    "The battery controller's own reading: remaining ÷ full-charge capacity. macOS keeps a small reserve, so the two differ slightly.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собственное измерение контроллера аккумулятора: оставшаяся ёмкость ÷ ёмкость полного заряда. macOS держит небольшой резерв, поэтому значения немного различаются."
          }
        }
      }
    },
    "The battery has cells in series. A spread that keeps growing hints at an ageing or unbalanced battery.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элементы аккумулятора соединены последовательно. Если разброс между ними растёт, аккумулятор стареет или разбалансирован."
          }
        }
      }
    },
    "The charts start over. This can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Графики начнутся заново. Это действие нельзя отменить."
          }
        }
      }
    },
    "The disk image doesn't contain the expected version of BatteryPulse.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В образе диска нет ожидаемой версии BatteryPulse."
          }
        }
      }
    },
    "The downloaded disk image couldn't be opened.": {
      "extractionState": "manual",
      "localizations": {
