          }
        }
      }
    },
    "Running sum of ChargerEfficiency samples; ÷ ChargerAccumEfficiencyCount gives the average.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накопленная сумма замеров ChargerEfficiency; ÷ ChargerAccumEfficiencyCount даёт среднее значение."
          }
        }
      }
    },
    "Running sum of negative BatteryPower samples in mW; ÷ its count gives average discharge power.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
