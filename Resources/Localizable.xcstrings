{
  "sourceLanguage": "en",
  "strings": {
    "%@ (bit %@)": {
      "extractionState": "manual",
      "comment": "Hex code and the one bit that is set, e.g. 0x80 (bit 7)",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (бит %@)"
          }
        }
      }
    },
    "%@ (bits %@)": {
      "extractionState": "manual",
      "comment": "Hex code and the bits that are set, e.g. 0x81 (bits 0, 7)",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (биты %@)"
          }
        }
      }
    },
    "%@ left": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осталось %@"
          }
        }
      }
    },
    "%@ of %@": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ из %@"
          }
        }
      }
    },
    "%@ of design": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ от расчётной"
          }
        }
      }
    },
    "%@ per hour": {
      "extractionState": "manual",
      "comment": "Average drain, e.g. 8.5% per hour",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ в час"
          }
        }
      }
    },
    "%@ remaining. Charge it soon.": {
      "extractionState": "manual",
      "comment": "Notification body for an accessory's low battery: its charge, e.g. 15%",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осталось %@. Скоро потребуется зарядка."
          }
        }
      }
    },
    "%@ Wh": {
      "extractionState": "manual",
      "comment": "Energy in watt-hours",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Вт·ч"
          }
        }
      }
    },
    "%@, charging": {
      "extractionState": "manual",
      "comment": "VoiceOver value of an accessory part in the menu bar panel: its charge, then that it charges",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, заряжается"
          }
        }
      }
    },
    "1 when the Mac lets the battery charge from the adapter; 0 on battery or while charging is paused.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1, если Mac разрешает заряжать аккумулятор от адаптера; 0 при работе от аккумулятора или при приостановленной зарядке."
          }
        }
      }
    },
    "24 Hours": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "24 часа"
          }
        }
      }
    },
    "7 Days": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "7 дней"
          }
        }
      }
    },
    "A": {
      "extractionState": "manual",
      "comment": "Unit symbol: amperes",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "А"
          }
        }
      }
    },
    "A 15 W phone charger barely keeps up.": {
      "extractionState": "manual",
      "comment": "Demo scene subtitle",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарядное устройство от телефона на 15 Вт едва справляется."
          }
        }
      }
    },
    "A 60 W USB-C adapter charges the battery.": {
      "extractionState": "manual",
      "comment": "Demo scene subtitle",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаптер USB-C на 60 Вт заряжает аккумулятор."
          }
        }
      }
    },
    "A New Version of BatteryPulse Is Available": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступна новая версия BatteryPulse"
          }
        }
      }
    },
    "About %@ left": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осталось примерно %@"
          }
        }
      }
    },
    "About BatteryPulse": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О программе BatteryPulse"
          }
        }
      }
    },
    "About once a minute while BatteryPulse runs, for the last 10 days, plus the battery's capacity and cycles once a day. It stays on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерно раз в минуту, пока работает BatteryPulse, за последние 10 дней, а также ёмкость и циклы аккумулятора раз в день. Данные остаются на этом Mac."
          }
        }
      }
    },
    "Accessories": {
      "extractionState": "manual",
      "comment": "Sidebar row, page title and menu bar panel caption: batteries of Bluetooth keyboards, mice, headphones",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аксессуары"
          }
        }
      }
    },
    "Accessories show here while they're connected to this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аксессуары показаны здесь, пока они подключены к этому Mac."
          }
        }
      }
    },
    "Accessories Unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аксессуары недоступны"
          }
        }
      }
    },
    "Accessory": {
      "extractionState": "manual",
      "comment": "Kind of accessory that macOS doesn't name",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аксессуар"
          }
        }
      }
    },
    "Accessory batteries": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккумуляторы аксессуаров"
          }
        }
      }
    },
    "Adapter": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адаптер"
          }
        }
      }
    },
    "Adapter error bits, e.g. insufficient power or a foreign object on a wireless charger.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Биты ошибок адаптера, например нехватка мощности или посторонний предмет на беспроводном зарядном устройстве."
          }
        }
      }
    },
    "Adapter family code: 0xE000400A is USB-C Power Delivery, 0 means nothing is connected.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код семейства адаптера: 0xE000400A — USB-C Power Delivery, 0 — ничего не подключено."
          }
        }
      }
    },
    "Adapter loss": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потери в адаптере"
          }
        }
      }
    },
    "Adapter maker's name as reported by the adapter.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название производителя, которое сообщает адаптер."
          }
        }
      }
    },
    "Adapter model ID as a hex string; the same value as AdapterID.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор модели адаптера в виде шестнадцатеричной строки; совпадает с AdapterID."
          }
        }
      }
    },
    "Adapter serial number.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серийный номер адаптера."
          }
        }
      }
    },
    "Adapter's own product name.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собственное название продукта адаптера."
          }
        }
      }
    },
    "Adds Raw Data (every value macOS reports, decoded and explained) and Demo Mode to the main window.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет в главное окно исходные данные (все значения, которые сообщает macOS, с расшифровкой и описанием) и демо-режим."
          }
        }
      }
    },
    "Advanced": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнения"
          }
        }
      }
    },
    "All": {
      "extractionState": "manual",
      "comment": "Raw Data toolbar switch: show every source",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все"
          }
        }
      }
    },
    "All History…": {
      "extractionState": "manual",
      "comment": "History → Export menu: the minute readings and the daily health as JSON",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся история…"
          }
        }
      }
    },
    "Allow BatteryPulse in Login Items to finish.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы завершить, разрешите BatteryPulse в разделе «Объекты входа»."
          }
        }
      }
    },
    "Animations": {
      "extractionState": "manual",
      "comment": "Demo Mode section",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анимации"
          }
        }
      }
    },
    "Apple's model ID for the adapter; the Model key shows the same number in hex.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идентификатор модели адаптера от Apple; ключ Model показывает то же число в шестнадцатеричном виде."
          }
        }
      }
    },
    "Augmented %@": {
      "extractionState": "manual",
      "comment": "USB Power Delivery augmented power offer, shown as a hex code",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расширенный %@"
          }
        }
      }
    },
    "Available in the installed app. Build it with scripts/build-app.sh.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно в установленном приложении. Соберите его с помощью scripts/build-app.sh."
          }
        }
      }
    },
    "Average battery current from the gauge; negative while discharging, positive while charging.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средний ток аккумулятора по данным контроллера; отрицательный при разрядке, положительный при зарядке."
          }
        }
      }
    },
    "Average battery temperature over the pack's life, in tenths of a degree Celsius.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средняя температура аккумулятора за весь срок службы, в десятых долях градуса Цельсия."
          }
        }
      }
    },
    "Average drain": {
      "extractionState": "manual",
      "comment": "Average battery drain per hour",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средний расход"
          }
        }
      }
    },
    "Banks": {
      "extractionState": "manual",
      "comment": "Raw Data toolbar switch: the cell bank entries (AppleSmartBatteryBank) and their cells",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группы"
          }
        }
      }
    },
    "Battery": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккумулятор"
          }
        }
      }
    },
    "Battery %@, %@": {
      "extractionState": "manual",
      "comment": "USB Power Delivery battery-supply offer: voltage range, power",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Батарейный %@, %@"
          }
        }
      }
    },
    "Battery and charging details for your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подробно об аккумуляторе и зарядке вашего Mac."
          }
        }
      }
    },
    "Battery charge level of the device attached to this port, as reported over USB PD.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уровень заряда аккумулятора устройства, подключённого к этому порту, по данным USB PD."
          }
        }
      }
    },
    "Battery charge: %@, %@": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряд аккумулятора: %@, %@"
          }
        }
      }
    },
    "Battery Charged to %@": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккумулятор заряжен до %@"
          }
        }
      }
    },
    "Battery current in mA from powerd, negative when discharging.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ток аккумулятора в мА по данным powerd; при разрядке отрицательный."
          }
        }
      }
    },
    "Battery current read from the SMC; positive while charging.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ток аккумулятора по данным SMC; положительный во время зарядки."
          }
        }
      }
    },
    "Battery design capacity of the device on this port, from USB PD, in 0.1 Wh units.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расчётная ёмкость аккумулятора устройства на этом порту по данным USB PD, в единицах 0,1 Вт·ч."
          }
        }
      }
    },
    "Battery gauge temperature read from the SMC, in tenths of a kelvin: 3069 is 33.75 °C.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Температура контроллера аккумулятора по данным SMC, в десятых долях кельвина: 3069 — это 33,75 °C."
          }
        }
      }
    },
    "Battery Health": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние аккумулятора"
          }
        }
      }
    },
    "Battery Health by Day…": {
      "extractionState": "manual",
      "comment": "History → Export menu: the daily battery health as CSV",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние аккумулятора по дням…"
          }
        }
      }
    },
    "Battery icon": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значок аккумулятора"
          }
        }
      }
    },
    "Battery Kiosk Mode dictionary, empty: this battery reports no Kiosk Mode state or counters.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Словарь режима Kiosk Mode пуст: аккумулятор не сообщает ни состояния Kiosk Mode, ни его счётчиков."
          }
        }
      }
    },
    "Battery Kiosk Mode state and its counters of time spent at high charge.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние режима Kiosk Mode и счётчики времени, проведённого аккумулятором при высоком заряде."
          }
        }
      }
    },
    "Battery pack temperature from the gauge, in hundredths of a degree Celsius.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Температура аккумулятора по данным контроллера аккумулятора, в сотых долях градуса Цельсия."
          }
        }
      }
    },
    "Battery pack voltage (sum of the cell voltages).": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напряжение аккумулятора (сумма напряжений элементов)."
          }
        }
      }
    },
    "Battery pack voltage as seen by the gauge.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напряжение аккумулятора по данным контроллера."
          }
        }
      }
    },
    "Battery pack voltage read from the SMC.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напряжение аккумулятора по данным SMC."
          }
        }
      }
    },
    "Battery pack voltage; reads the same as Voltage on Apple silicon.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напряжение аккумулятора; на Mac с чипом Apple совпадает с Voltage."
          }
        }
      }
    },
    "Battery position for multi-battery machines; 0 on single-battery Macs.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер аккумулятора в системах с несколькими аккумуляторами; 0 на Mac с одним аккумулятором."
          }
        }
      }
    },
    "Battery power": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мощность аккумулятора"
          }
        }
      }
    },
    "Battery Service Recommended": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендуется обслуживание аккумулятора"
          }
        }
      }
    },
    "Battery temperature estimate in hundredths of a degree Celsius.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расчётная температура аккумулятора в сотых долях градуса Цельсия."
          }
        }
      }
    },
    "Battery temperature in hundredths of a degree Celsius, as reported via the SMC.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Температура аккумулятора в сотых долях градуса Цельсия по данным SMC."
          }
        }
      }
    },
    "Battery temperature in hundredths of a degree Celsius: 3100 is 31 °C.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
