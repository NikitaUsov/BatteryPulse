    "BatteryPulse always shows a Dock icon when it isn't in the menu bar.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда BatteryPulse нет в строке меню, его значок всегда показан в Dock."
          }
        }
      }
    },
