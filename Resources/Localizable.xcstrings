          }
        }
      }
    },
    "Running sum of positive (charging) BatteryPower samples in mW; ÷ its count gives average.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накопленная сумма положительных (при зарядке) замеров BatteryPower в мВт; ÷ их число даёт среднее."
          }
        }
      }
    },
    "Running sum of SystemEffectiveTotalLoad samples; Macs leave it at 0.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накопленная сумма замеров SystemEffectiveTotalLoad; на Mac всегда 0."
          }
        }
      }
    },
    "Running sum of SystemLoad samples in mW; ÷ SystemLoadAccumulatorCount gives average load.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накопленная сумма замеров SystemLoad в мВт; ÷ SystemLoadAccumulatorCount даёт среднюю нагрузку."
          }
        }
      }
    },
    "Running sum of SystemPowerIn samples in mW; compare readings by their difference modulo 2^32.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накопленная сумма замеров SystemPowerIn в мВт; сравнивайте показания по их разности по модулю 2^32."
          }
        }
      }
    },
    "Running sum of the matching once-a-second telemetry value; some totals carry spurious 2^32 jumps.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накопленная сумма соответствующего ежесекундного значения телеметрии; в некоторых суммах бывают ложные скачки на 2^32."
          }
        }
      }
    },
    "Running total of AdapterEfficiencyLoss in µWh; reduce it modulo 2^32 to get the real sum.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накопленная сумма AdapterEfficiencyLoss в мкВт·ч; для реальной суммы возьмите остаток по модулю 2^32."
          }
        }
      }
    },
    "Running total of SystemEnergyConsumed in µWh; ignore steps of about 1193046471 (2^32 ÷ 3.6).": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
