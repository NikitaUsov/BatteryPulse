      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключено, значок всё равно появляется в Dock, пока открыто окно BatteryPulse."
          }
        }
      }
    },
    "Worn battery": {
      "extractionState": "manual",
      "comment": "Demo scene",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изношенный аккумулятор"
          }
        }
      }
    },
    "Yes": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Да"
          }
        }
      }
    },
    "You can download the update and install it from the DMG instead.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместо этого можно загрузить обновление и установить его из DMG."
          }
        }
      }
    },
    "You can unplug the power adapter.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно отключить адаптер питания."
          }
        }
      }
    },
    "You have BatteryPulse %@.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас BatteryPulse %@."
          }
        }
      }
    },
    "Your Mac Is Running Hot": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac сильно нагрелся"
          }
        }
      }
    },
    "Zero-based position of the negotiated USB-PD power profile in the adapter's offer.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер согласованного профиля питания USB-PD в предложении адаптера, начиная с 0."
          }
        }
      }
    },
    "Zero-based position of this USB-PD profile in the adapter's offer list.": {
      "extractionState": "manual",
      "comment": "Developer table: what a raw key means",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер этого профиля USB-PD в списке предложений адаптера, начиная с 0."
          }
        }
      }
    },
    "“%@” didn't answer. Check the cable and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не отвечает. Проверьте кабель и повторите попытку."
          }
        }
      }
    },
    "“%@” didn't answer. Keep it unlocked and on the same Wi-Fi network as this Mac, or connect it by cable.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не отвечает. Держите устройство разблокированным и в той же сети Wi-Fi, что и этот Mac, или подключите его кабелем."
          }
        }
      }
    },
    "“%@” didn't report a battery.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не сообщает данные аккумулятора."
          }
        }
      }
    },
    "“%@” doesn't trust this Mac. Unlock it and tap Trust; if no prompt appears, select it in Finder once.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не доверяет этому Mac. Разблокируйте устройство и коснитесь «Доверять»; если запрос не появляется, один раз выберите устройство в Finder."
          }
        }
      }
    }
  },
  "version": "1.0"
